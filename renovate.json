{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "PRs are created at any time from the 1st to the 3rd of each month",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * 1-3 * *"],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "postUpdateOptions": ["gomodTidy"]
}
